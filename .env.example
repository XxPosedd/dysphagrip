# Copy to .env (never commit .env). All integrations are optional: the app starts without them
# and reports each one as "not configured" instead of faking it.

# --- Express API ---
PORT=3000
NODE_ENV=development
# Public hosted demo only (e.g. Vultr): blocks saving/deleting sessions. Leave unset on the presenter's laptop.
DEMO_READ_ONLY=

# --- Neon Postgres (Phase 6) ---
# From the Neon console → Connection string (pooled). Example:
# DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# --- ElevenLabs text-to-speech --- server-side only, never exposed to the browser.
# API key: elevenlabs.io → profile → API Keys. Voice ID: Voices → pick a voice → copy its ID.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# Optional. Defaults to eleven_multilingual_v2 (ElevenLabs' documented default model).
ELEVENLABS_MODEL_ID=

# --- Bright Data (Web Unlocker API) --- server-side only. Used by `npm run resources:refresh`.
# Control panel → create a "Web Unlocker API" zone → its Overview tab shows the API key and zone name.
BRIGHTDATA_API_TOKEN=
BRIGHTDATA_ZONE=

# --- Frontend (Vite; values here ARE public, never put secrets in VITE_*) ---
# Leave empty in development: Vite proxies /api to :3000 and /audio to the Python service on :8765.
VITE_API_URL=
VITE_AUDIO_WS_URL=
